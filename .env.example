# ─────────────────────────────────────────────────────────────────────────────
# 환경변수 예시 — 실제 값은 .env / .env.local 에 넣고 절대 커밋하지 마세요.
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저 번들에 포함됩니다. (비밀키에 붙이지 말 것)
# ─────────────────────────────────────────────────────────────────────────────

# ─── DB (Supabase PostgreSQL) ────────────────────────────────────────────────
# Transaction Pooler(6543, pgbouncer=true)
DATABASE_URL=
# Direct connection(5432) — 마이그레이션용
DIRECT_URL=

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (쓰기 채점·AI 문제 생성) ─────────────────────────────────────────
OPENAI_API_KEY=
# 모델 교체(선택) — 비워두면 기본값 사용: gpt-4o-mini / 이미지 입력 gpt-4o
OPENAI_MODEL=
OPENAI_VISION_MODEL=
# 관리자 문법 콘텐츠(원고 분석·개념 정리·강의 스크립트)용 — 비워두면 OPENAI_MODEL
OPENAI_CONTENT_MODEL=
# AI 강의 장면 배경 그림 — 비워두면 gpt-image-1-mini (GPT 이미지 모델은 OpenAI 조직 인증 필요)
OPENAI_IMAGE_MODEL=

# ─── 결제 (PortOne / Toss) ───────────────────────────────────────────────────
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_INICIS=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─── 운영 ────────────────────────────────────────────────────────────────────
# Vercel Cron 인증 (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
SLACK_WEBHOOK_URL=

# ─── 학부모 알림 (SOLAPI 카카오 알림톡 + SMS/LMS 대체발송) ──────────────────
# 발송 모드: "live" = 실제 발송 / "log" = 발송하지 않고 NotificationLog에 기록만
# 값이 없거나 "live"가 아니면 항상 "log"로 동작합니다. (개발 환경은 반드시 log 유지)
NOTIFICATION_MODE=log

# SOLAPI 콘솔 > API Key 관리에서 발급 (서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 연동한 카카오 비즈니스 채널의 pfId (SOLAPI 콘솔 > 카카오 채널)
SOLAPI_PFID=
# SOLAPI에 사전 등록·인증된 발신번호 (숫자만, 예: 0212345678)
SOLAPI_SENDER_NUMBER=
# (SOLAPI_SENDER 로 넣어도 됩니다 — 둘 다 있으면 SOLAPI_SENDER_NUMBER 우선)

# 카카오 검수를 통과한 알림톡 템플릿 ID (문구 초안: docs/alimtalk-templates.md)
# 비워두면 해당 알림은 알림톡 대신 같은 문구의 SMS/LMS로 발송됩니다.
SOLAPI_TEMPLATE_APPOINTMENT_CONFIRMED=
SOLAPI_TEMPLATE_APPOINTMENT_REMINDER=
SOLAPI_TEMPLATE_PLACEMENT_TEST_LINK=
SOLAPI_TEMPLATE_PLACEMENT_TEST_RESULT=
SOLAPI_TEMPLATE_INQUIRY_RECEIVED=
# 출결 알림 (출결관리 4단계 — 알림 크레딧 차감, /api/cron/notifications 가 1분마다 발송)
SOLAPI_TEMPLATE_ATTENDANCE_CHECK_IN=
SOLAPI_TEMPLATE_ATTENDANCE_CHECK_IN_LATE=
SOLAPI_TEMPLATE_ATTENDANCE_CHECK_OUT=
SOLAPI_TEMPLATE_ATTENDANCE_CHECK_OUT_SUMMARY=
SOLAPI_TEMPLATE_ATTENDANCE_ABSENT=

# 알림에 넣을 앱 주소 (레벨테스트 링크 등). 비우면 현재 요청 호스트를 사용
# 예: https://login.wegoupenglish.com
APP_BASE_URL=

# 외부 상담신청 폼(/apply/…) 제출 간격 검사용 서명 키 (비우면 SUPABASE_SERVICE_ROLE_KEY 사용)
APPLY_FORM_SECRET=

# ElevenLabs — AI 강의 음성 생성 (관리자 전용, 서버 전용: NEXT_PUBLIC_ 붙이지 말 것)
ELEVENLABS_API_KEY=
# 기본 목소리 ID (관리자가 스크립트에서 고르지 않았을 때)
ELEVENLABS_KO_VOICE_ID=
ELEVENLABS_EN_VOICE_ID=
# 선택: 모델 ID (비우면 eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=

# AI 강의 Remotion PC 렌더 (npm run lecture:render) — 로컬 전용, Vercel에는 필요 없음
# 직원 4명 이상 회사는 Remotion 회사 라이선스 필요 (키가 있으면 렌더 시 함께 보냄)
REMOTION_LICENSE_KEY=
# 렌더 브라우저 경로 (비우면 Mac은 설치된 Google Chrome, 그 외는 Remotion 전용 Chrome)
REMOTION_BROWSER_EXECUTABLE=
