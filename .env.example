# ─────────────────────────────────────────────────────────────────────────────
# 환경변수 예시 — 실제 값은 .env / .env.local 에 넣고 절대 커밋하지 마세요.
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저 번들에 포함됩니다. (비밀키에 붙이지 말 것)
# ─────────────────────────────────────────────────────────────────────────────

# ─── DB (Supabase PostgreSQL) ────────────────────────────────────────────────
# Transaction Pooler(6543, pgbouncer=true)
DATABASE_URL=
# Direct connection(5432) — 마이그레이션용
DIRECT_URL=

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (쓰기 채점·AI 문제 생성) ─────────────────────────────────────────
OPENAI_API_KEY=

# ─── 결제 (PortOne / Toss) ───────────────────────────────────────────────────
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_INICIS=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─── 운영 ────────────────────────────────────────────────────────────────────
# Vercel Cron 인증 (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
SLACK_WEBHOOK_URL=

# ─── 학부모 알림 (SOLAPI 카카오 알림톡 + SMS/LMS 대체발송) ──────────────────
# 발송 모드: "live" = 실제 발송 / "log" = 발송하지 않고 NotificationLog에 기록만
# 값이 없거나 "live"가 아니면 항상 "log"로 동작합니다. (개발 환경은 반드시 log 유지)
NOTIFICATION_MODE=log

# SOLAPI 콘솔 > API Key 관리에서 발급 (서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 연동한 카카오 비즈니스 채널의 pfId (SOLAPI 콘솔 > 카카오 채널)
SOLAPI_PFID=
# SOLAPI에 사전 등록·인증된 발신번호 (숫자만, 예: 0212345678)
SOLAPI_SENDER_NUMBER=

# 카카오 검수를 통과한 알림톡 템플릿 ID (문구 초안: docs/alimtalk-templates.md)
# 비워두면 해당 알림은 알림톡 대신 같은 문구의 SMS/LMS로 발송됩니다.
SOLAPI_TEMPLATE_APPOINTMENT_CONFIRMED=
SOLAPI_TEMPLATE_APPOINTMENT_REMINDER=
SOLAPI_TEMPLATE_PLACEMENT_TEST_LINK=
SOLAPI_TEMPLATE_PLACEMENT_TEST_RESULT=
