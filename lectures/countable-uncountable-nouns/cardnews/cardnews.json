{
  "version": 1,
  "slug": "countable-uncountable-nouns",
  "title": "셀 수 있는 명사와 셀 수 없는 명사",
  "cards": [
    {
      "type": "cover",
      "topic": "셀 수 있는·없는 명사",
      "hook": "money에 many? 헷갈린다면 꼭!",
      "label": "중학 영문법"
    },
    {
      "type": "question",
      "sentence": "How many money do you have?",
      "prompt": "이거 맞을까요?",
      "hint": "money는 셀 수 있을까요?"
    },
    {
      "type": "rule",
      "heading": "셀 수 있는 명사",
      "lines": [
        "**a/an + 단수**, **숫자 + 복수(-s)**",
        "수량은 **many·a few**"
      ],
      "example": {
        "en": "I need a pen and two notebooks.",
        "ko": "난 펜 한 자루와 공책 두 권이 필요해"
      }
    },
    {
      "type": "rule",
      "heading": "셀 수 없는 명사",
      "lines": [
        "**a/an**도 **-s**도 없이, 동사는 단수",
        "수량은 **much·a little**, 세려면 단위"
      ],
      "example": {
        "en": "Can I get a glass of water?",
        "ko": "물 한 잔 주시겠어요?"
      }
    },
    {
      "type": "rule",
      "heading": "둘 다 되는 명사",
      "lines": [
        "**chicken** 닭고기 / **a chicken** 닭 한 마리",
        "**time** 시간 / **three times** 세 번"
      ],
      "example": {
        "en": "Two coffees, please.",
        "ko": "커피 두 잔 주세요"
      }
    },
    {
      "type": "mistakes",
      "heading": "흔한 실수 TOP 3",
      "items": [
        {
          "wrong": "a lot of homeworks",
          "right": "a lot of homework"
        },
        {
          "wrong": "an advice",
          "right": "some advice"
        },
        {
          "wrong": "buy new phone",
          "right": "buy a new phone"
        }
      ]
    },
    {
      "type": "quiz",
      "question": "빈칸에 알맞은 말은?",
      "sentence": "We don't have ___ milk.",
      "choices": [
        "many",
        "much"
      ]
    },
    {
      "type": "answer",
      "answer": "much",
      "sentence": "We don't have much milk.",
      "explanation": "milk는 셀 수 없는 명사라 much를 써요."
    },
    {
      "type": "pattern",
      "pattern": "Can I get ~?",
      "slot": "명사",
      "ko": "~ 주시겠어요?",
      "example": {
        "en": "Can I get a cup of tea, please?",
        "ko": "차 한 잔 주시겠어요?"
      }
    },
    {
      "type": "cta",
      "lectureTitle": "셀 수 있는 명사와 셀 수 없는 명사",
      "message": "저장하고 복습하세요"
    }
  ]
}
