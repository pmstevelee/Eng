    },
    {
      "type": "rule",
      "heading": "who·which·that 구별",
      "formula": [
        "사람+who",
        "사물+which",
        "둘 다+that"
      ],
      "lines": [
        "일상에선 사물에 that을 더 자주"
      ],
      "example": {
        "en": "This is the bus that goes downtown.",
        "ko": "이게 시내로 가는 버스예요"
      }
    },
